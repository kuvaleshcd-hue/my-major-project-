# ══════════════════════════════════════════════════════════════
# Google OAuth Configuration for Zivana
# ══════════════════════════════════════════════════════════════
# To enable "Sign in with Google":
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI:
#    - Local:  http://localhost:8501/oauth2callback
#    - Cloud:  https://your-app.streamlit.app/oauth2callback
# 4. Copy client_id and client_secret below
# 5. Rename this file to secrets.toml
# ══════════════════════════════════════════════════════════════

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET_STRING"

[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
