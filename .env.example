# Copy this to .env and fill in your key — NEVER commit .env
SARVAM_API_KEY=your_sarvam_api_key_here
SMTP_EMAIL="your_email_address@gmail.com"
SMTP_PASSWORD="your_app_password"

# Optional: For Lip Sync / Wav2Lip feature (Get token from https://replicate.com)
REPLICATE_API_TOKEN=your_replicate_key_here
